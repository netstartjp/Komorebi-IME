diff --git a/src/android/jni/mozcjni.cc b/src/android/jni/mozcjni.cc
--- a/src/android/jni/mozcjni.cc
+++ b/src/android/jni/mozcjni.cc
@@ -59,6 +59,40 @@
 // The global instance of Mozc system to be initialized in onPostLoad().
 std::unique_ptr<SessionHandler> g_session_handler;
 
+// Drops the parts of an Output that never cross into the app, before it is serialized.
+//
+// `all_candidate_words` dominates the response: typing one kana produces around 200 entries and
+// 78KB of protobuf, against 9 candidates actually shown and 250 bytes of everything else. Every
+// keystroke was serializing that, copying it over JNI, and parsing it back into 200 Java objects.
+//
+// The client re-ranks a bounded pool, so it needs id/key/value/attributes for the first 32 words.
+// CandidateWindow contains only the currently visible page and does not carry generation
+// attributes, so stripping those fields breaks typing-correction and user-dictionary provenance.
+// Everything after the live pool, plus annotations and debug-only fields, can still be dropped.
+//
+// This trims the message; it does not change what the app can compute from it.
+void TrimOutputForClient(mozc::commands::Output* output) {
+  output->clear_removed_candidate_words_for_debug();
+  output->clear_incognito_candidate_words();
+
+  if (!output->has_all_candidate_words()) {
+    return;
+  }
+  auto* candidates =
+      output->mutable_all_candidate_words()->mutable_candidates();
+  constexpr int kMaxClientCandidates = 32;
+  if (candidates->size() > kMaxClientCandidates) {
+    candidates->DeleteSubrange(kMaxClientCandidates,
+                               candidates->size() - kMaxClientCandidates);
+  }
+  for (auto& word : *candidates) {
+    word.clear_index();
+    word.clear_annotation();
+    word.clear_num_segments_in_candidate();
+    word.clear_log();
+  }
+}
+
 // Concrete implementation for MozcJni.evalCommand
 jbyteArray JNICALL evalCommand(JNIEnv* env, jclass clazz,
                                jbyteArray in_bytes_array) {
@@ -68,6 +102,9 @@
   command.ParseFromArray(in_bytes, in_size);
   if (g_session_handler) {
     g_session_handler->EvalCommand(&command);
+    if (command.has_output()) {
+      TrimOutputForClient(command.mutable_output());
+    }
   } else {
     LOG(DFATAL) << "Mozc session handler is not yet initialized";
   }
