+// Concrete implementation for MozcJni.setEncryptionKey
+//
+// Supplies the key that EncryptedStringStorage uses for the conversion history and the user
+// dictionary. Call this before onPostLoad(): the engine reads those files while it is being built,
+// and without a key it would decline to load or save them.
+jboolean JNICALL setEncryptionKey(JNIEnv* env, jclass clazz,
+                                  jbyteArray key_array) {
+  if (key_array == nullptr) {
+    LOG(ERROR) << "Encryption key is null";
+    return false;
+  }
+  jbyte* key = env->GetByteArrayElements(key_array, nullptr);
+  const jsize key_size = env->GetArrayLength(key_array);
+  const bool result = PasswordManager::SetInjectedPassword(
+      absl::string_view(reinterpret_cast<const char*>(key), key_size));
+  // JNI_ABORT: the key is read only, and it must not be copied back into the Java array.
+  env->ReleaseByteArrayElements(key_array, key, JNI_ABORT);
+  return result;
+}
