+//////////////////////////////////////////////////////////////////
+// AndroidPasswordManager
+//
+// Keeps the password in memory only. See PasswordManager::SetInjectedPassword for why: the
+// password arrives from the Java side, sealed at rest by an Android Keystore key, so this process
+// has nothing to store and no file to protect.
+#ifdef __ANDROID__
+namespace {
+
+constinit absl::Mutex g_injected_mutex(absl::kConstInit);
+std::string* g_injected_password ABSL_GUARDED_BY(g_injected_mutex) = nullptr;
+
+}  // namespace
+
+class AndroidPasswordManager {
+ public:
+  static bool SetPassword(const std::string& password);
+  static bool GetPassword(std::string* password);
+  static bool RemovePassword();
+};
+
+// Called by PasswordManagerImpl when GetPassword found nothing. There is deliberately no fallback
+// to a self-generated password: it could not be persisted, so every launch would encrypt the
+// history with a key that dies with the process and silently lose the previous run's learning.
+// Failing here instead leaves the existing file untouched.
+bool AndroidPasswordManager::SetPassword(const std::string&) {
+  LOG(ERROR) << "No password has been injected; refusing to generate an ephemeral one";
+  return false;
+}
+
+bool AndroidPasswordManager::GetPassword(std::string* password) {
+  if (password == nullptr) {
+    LOG(ERROR) << "password is nullptr";
+    return false;
+  }
+  absl::MutexLock l(g_injected_mutex);
+  if (g_injected_password == nullptr) {
+    return false;
+  }
+  password->assign(*g_injected_password);
+  return true;
+}
+
+bool AndroidPasswordManager::RemovePassword() {
+  absl::MutexLock l(g_injected_mutex);
+  delete g_injected_password;
+  g_injected_password = nullptr;
+  return true;
+}
+#endif  // __ANDROID__
+
